# Barka Environment Variables
# Copy to .env and fill

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Never expose service_role in frontend!

# For Edge Functions (server-side only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# META_CAPI_ACCESS_TOKEN_ENCRYPTION_KEY=your-32-byte-key
# DELIVERY_PROVIDER_ENCRYPTION_KEY=your-32-byte-key

# App
VITE_APP_URL=https://barka.tn
VITE_APP_NAME=Barka
VITE_DEFAULT_CURRENCY=TND
VITE_DEFAULT_LANGUAGE=fr

# Cloudflare Pages will inject these at build time
